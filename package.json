{
  "name": "app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:shitzu": "yarn workspace shitzu-app dev",
    "dev:meme": "yarn workspace meme-cooking dev",
    "build": "yarn workspace shitzu-app build && yarn workspace meme-cooking build",
    "build:shitzu": "yarn workspace shitzu-app build",
    "build:meme": "yarn workspace meme-cooking build",
    "check": "yarn workspace @repo/lib run check && yarn workspace shitzu-app run check && yarn workspace meme-cooking run check",
    "lint": "eslint --max-warnings=0 apps/shitzu-app/src apps/meme-cooking/src packages/lib/src && prettier --check .",
    "format": "prettier --write .",
    "test": "yarn workspace @repo/lib test",
    "test:live": "INTEAR_LIVE=1 JUPITER_LIVE=1 yarn workspace @repo/lib test",
    "api-gen": "yarn workspace @repo/lib api-gen"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.9.0",
    "@typescript-eslint/parser": "^7.9.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-typescript": "^3",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-svelte": "^2.39.0",
    "prettier": "^3.2.5",
    "prettier-plugin-svelte": "^3.2.3",
    "svelte": "^4.2.17",
    "typescript": "5.7.3"
  }
}
